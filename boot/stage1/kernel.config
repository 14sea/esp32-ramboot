# Stage-1 引導內核（x86_64，UEFI stub，內嵌 initramfs）。基於 tinyconfig，由 boot/build.sh 合併；@INITRAMFS_LIST@ 由它填
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB_TINY=y
# CONFIG_KALLSYMS is not set
# CONFIG_BUG is not set
CONFIG_LOG_BUF_SHIFT=15
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=n
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y

# ── initramfs ──
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="@INITRAMFS_LIST@"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ── x86 / UEFI ──
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200 console=tty0"
CONFIG_X86_MSR=n
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=n
# CONFIG_X86_MCE is not set
# CONFIG_MICROCODE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set

# ── kexec ──
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC=y

# ── 文件系統 ──
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BLOCK=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="ascii"
CONFIG_NLS_CODEPAGE_437=y
# FAT 默認 iocharset 是 ascii，不編進來會報 "IO charset ascii not found" 掛不上
CONFIG_NLS_ASCII=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# ── 控制台：串口（QEMU/調試）+ UEFI 幀緩衝（屏幕）──
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=n
CONFIG_SERIAL_8250_PNP=n
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ── 網絡協議棧 ──
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
# CONFIG_IPV6 is not set
# CONFIG_WIRELESS is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_CORE=y

# ── 有線網卡（常見 PC + 虛擬機）──
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139CP=y
CONFIG_8139TOO=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL1C=y
CONFIG_ALX=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# ── USB：主控 + 免驅 USB 網卡（CDC/NCM/RNDIS 的外接網卡或手機共享）+ U 盤 ──
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_ZAURUS is not set
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
