#!/bin/sh
# r <命令…>：跑一條命令並把輸出（最多 30 行）經啟動盤那塊板子報給主機。
# Stage-1 失敗後停在控制台 shell 裡時，主機用藍牙鍵盤打 r … 來查原因
d=
for b in /sys/block/sd*; do
    case "$(cat $b/device/model 2>/dev/null)" in *"S3 Boot Disk"*) d=/dev/${b##*/} ;; esac
done
[ -n "$d" ] || { echo "no boot disk board"; exit 1; }
"$@" 2>&1 | head -n 30 | cut -c1-110 | while IFS= read -r l; do s1tool msg $d "s1 | $l"; done
s1tool msg $d "s1 run done: $*"
