# Copy this file to boards.env and set the values for your boards. boards.env is not in the repository.
# The serial number of a board is its MAC address. To find it, connect the board and run:
#   ls /dev/serial/by-id/
DEVICE_MAC=AA:BB:CC:DD:EE:01
BRIDGE_MAC=AA:BB:CC:DD:EE:02
# Only for scripts/flash_remote.sh: the SSH name of the computer that the boards are connected to.
REMOTE_HOST=user@host
