CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 可重現構建：調試信息裡的路徑換成 /IDF、/IDF_PROJECT 這類佔位，固件裡不帶編譯時間。
# 用 gdb 時要加載 build/prefix_map_gdbinit（idf.py gdb 會自動加）
CONFIG_APP_REPRODUCIBLE_BUILD=y

# 原生 USB-Serial-JTAG 口專門走數據（主機 tools/kvm.py），日誌只走 UART0
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- BLE：NimBLE 中心端，只連一個設備 ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# 一行回執最長 509 字節，要佔 2–3 個 256 字節的 mbuf 塊；默認 12 塊在連續收數據行時會被佔滿，
# 寫請求（心跳）拿不到緩衝 → @err write_failed。加到 48
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=48
# 分區表和 0.2 版（帶 ESP-NOW 時）相同：只重燒應用就能從舊固件換過來，NVS 裡的藍牙綁定保留
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
