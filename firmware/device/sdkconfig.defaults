CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 可重現構建：調試信息裡的路徑換成 /IDF、/IDF_PROJECT 這類佔位，固件裡不帶編譯時間。
# 用 gdb 時要加載 build/prefix_map_gdbinit（idf.py gdb 會自動加）
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# 原生 USB 口給 TinyUSB（接目標電腦），控制台只走 UART0。日誌另有環形緩衝，經 BLE 的 log 命令讀
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- WiFi：只在 USB 模式 net 時開（把目標機的以太網幀轉到 WiFi）----
# WiFi 收得比 USB 全速口發得快，接收緩衝要夠；聚合窗口開大
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=48
CONFIG_ESP_WIFI_RX_BA_WIN=16

# ---- BLE：NimBLE 外設，只允許一個連接 ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_SC=y
# 綁定信息存 NVS，重啟後不用重新配對
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# 一行回執最長 509 字節，要佔 2–3 個 256 字節的 mbuf 塊；默認 12 塊在連續發數據行時會被佔滿，
# 寫進來的心跳拿不到緩衝。加到 48
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=48
